{
  "name": "son-of-anton",
  "version": "1.0.0",
  "description": "Autonomous issue fixer daemon",
  "main": "anton-daemon.ts",
  "scripts": {
    "start": "tsx anton-daemon.ts",
    "dev": "yarn ui:build && tsx anton-daemon.ts",
    "test": "yarn tsx issue-state.test.ts && yarn tsx src/repositories/FileSystemIssueRepository.test.ts && yarn tsx src/resources/routes.test.ts",
    "tsp:compile": "tsp compile status-api.tsp",
    "tsp:generate": "openapi-ts",
    "generate": "yarn tsp:compile && yarn tsp:generate",
    "ui:dev": "yarn --cwd ui dev",
    "ui:build": "yarn --cwd ui build",
    "build": "yarn generate && yarn ui:build"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "execa": "^8.0.1",
    "fastify": "^4.26.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.1",
    "@types/node": "^20.11.24",
    "@typespec/compiler": "^1.11.0",
    "@typespec/http": "^1.11.0",
    "@typespec/openapi": "^1.11.0",
    "@typespec/openapi3": "^1.11.0",
    "@typespec/rest": "^0.81.0",
    "pino-pretty": "^10.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.1",
    "typescript": "^5.3.3"
  }
}