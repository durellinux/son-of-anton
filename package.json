{
  "name": "son-of-anton",
  "version": "1.0.0",
  "description": "Autonomous issue fixer daemon",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "nx run daemon:start",
    "dev": "nx run-many -t dev",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "generate": "nx run daemon:build",
    "tsp:compile": "yarn --cwd apps/daemon tsp:compile",
    "tsp:generate": "yarn --cwd apps/daemon tsp:generate",
    "ui:dev": "nx run ui:dev",
    "ui:build": "nx run ui:build",
    "daemon:dev": "nx run daemon:dev",
    "daemon:build": "nx run daemon:build",
    "lint": "yarn eslint && yarn prettier",
    "lint:fix": "yarn eslint:fix && yarn prettier:fix",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "run-checks": "yarn lint && yarn typecheck",
    "start:all": "tsx scripts/startup.ts"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "^1.14.4",
    "@restatedev/restate-sdk-clients": "^1.14.4",
    "@restatedev/restate-server": "^1.6.2",
    "execa": "^8.0.1",
    "fastify": "^4.26.2",
    "nx": "19.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.97.1",
    "@types/node": "^20.11.24",
    "@typespec/compiler": "^1.11.0",
    "@typespec/http": "^1.11.0",
    "@typespec/openapi": "^1.11.0",
    "@typespec/openapi3": "^1.11.0",
    "@typespec/rest": "^0.81.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.9"
  }
}
